# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# What spends money (every model call records its model, tokens and cost in
# the `runs` table; the Spend page adds them up):
#   ANTHROPIC_API_KEY  judge, read, draft (and its claim check), queries (propose,
#                      filter results), recheck, describe, bios, enrich, events,
#                      moves, lead (paste --extract, vet, domains), unblock, audit
#   TAVILY_API_KEY     queries --run / --compare, recheck, lead domains and
#                      addresses, news, harvest (search credits, not dollars)
# gate, rank, dash, inbox and the other lead subcommands make no paid calls.
# `npm run daily` runs the paid stages on a schedule; see src/daily.mjs.

# Claude. Get one at https://console.anthropic.com/settings/keys
# An `ant auth login` profile works instead; the SDK resolves API key first,
# then auth token, then the profile.
ANTHROPIC_API_KEY=sk-ant-...

# Tavily, for dated news retrieval. https://app.tavily.com  (free tier ~1000
# credits/month, which is ample for a book of this size).
#
# Used to detect the events that make a prospect live NOW: an executive
# appointment, a funding round, an acquisition, a published cost concern.
# Nothing else in this system can see those — job boards show an empty seat,
# never the announcement that filled it.
#
# NOTE, learned in geo-herd-rider and it applies here: Tavily's server-side
# end_date is not reliably honored, and some results carry no published_date at
# all. Both are handled client-side. A result with no date is DROPPED rather
# than kept, because a trigger without a date is not a trigger — the design grades
# every dossier on whether its "why now" is a specific datable event.
TAVILY_API_KEY=tvly-...

# Optional OVERRIDE for Tavily pacing, in seconds between calls.
#
# You should not need this. The code paces itself to stay under the free tier's
# 100 requests/minute by default, because a per-firm x per-trigger sweep over a
# book this size is ~90 queries and would otherwise fire 2-5 per second and 429
# partway through. Set this only to go FASTER on the 1000/min tier:
#     TAVILY_MIN_INTERVAL=0.06     # ~1000/min
# or slower if you are sharing the key with another project.
#
# The binding constraint is not requests per minute anyway — it is the free
# tier's ~1000 credits per MONTH. `news` reports credits spent per run so that
# budget stays visible.
# TAVILY_MIN_INTERVAL=0.7
